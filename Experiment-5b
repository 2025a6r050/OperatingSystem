#include <stdio.h>
#include <string.h>

int main()
{
    char str[100];

    printf("Enter string: ");
    scanf("%99s", str);

    printf("Length: %lu\n", (unsigned long)strlen(str));

    printf("Substring: ");

    for(int i = 0; i < 5 && str[i] != '\0'; i++)
    {
        printf("%c", str[i]);
    }

    return 0;
}
